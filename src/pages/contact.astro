---
import Base from '../layouts/Base.astro';
import SiteTop from '../components/SiteTop.astro';
import { band } from '../config';
---

<Base title="Contact" description="Contact New Romans for booking, press and everything else." bare>
  <SiteTop />

  <section class="hello">
    <h1>Don't be shy, say hello.</h1>
    <a href={`mailto:${band.email}`}>{band.email}</a>
  </section>
</Base>

<style>
  .hello {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.5rem;
    min-height: 100svh;
    padding: calc(var(--gutter) * 2 + 3rem) var(--gutter) var(--gutter);
    background: #000;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2rem, 1.2rem + 3vw, 4rem);
    line-height: 1.1;
    color: var(--cream);
  }

  a {
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 0.8rem + 0.4vw, 1.15rem);
    letter-spacing: 0.06em;
    color: var(--cream);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    overflow-wrap: anywhere;
  }

  a:hover {
    color: #fff;
  }
</style>

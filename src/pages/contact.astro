---
import Base from '../layouts/Base.astro';
import { band } from '../config';
---

<Base title="Contact" description="Contact New Romans for booking, press and everything else.">
  <header class="page-head wrap">
    <p class="label" data-reveal>Booking · Press · Hello</p>
    <h1 class="display" data-reveal style="--reveal-delay: 0.1s">
      Get in <span class="accent">touch</span>
    </h1>
  </header>

  <section class="wrap contact">
    <div class="intro" data-reveal>
      <p class="lede">Booking a show, writing a piece, or just want to say hi? Drop us a line.</p>
      <p>
        Or email <a href={`mailto:${band.email}`}>{band.email}</a>
      </p>
    </div>

    <!-- Netlify detects this form at deploy time from the static HTML. -->
    <form
      class="form"
      name="contact"
      method="POST"
      action="/thanks/"
      data-netlify="true"
      netlify-honeypot="bot-field"
      data-reveal
      style="--reveal-delay: 0.2s"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="visually-hidden">
        <label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div class="field">
        <label for="name" class="label">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" required />
      </div>

      <div class="field">
        <label for="email" class="label">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>

      <div class="field">
        <label for="topic" class="label">About</label>
        <select id="topic" name="topic">
          <option>Booking</option>
          <option>Press</option>
          <option>Something else</option>
        </select>
      </div>

      <div class="field">
        <label for="message" class="label">Message</label>
        <textarea id="message" name="message" rows="6" required></textarea>
      </div>

      <button class="btn" type="submit">Send it <span aria-hidden="true">→</span></button>
    </form>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-bottom: clamp(4rem, 10vw, 8rem);
  }

  @media (max-width: 820px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }

  .intro .lede {
    margin-top: 0;
  }

  .form {
    display: grid;
    gap: 1.6rem;
  }

  .field {
    display: grid;
    gap: 0.5rem;
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 0.85rem 0;
    border: 0;
    border-bottom: 1px solid var(--cream-dim);
    border-radius: 0;
    background: transparent;
    color: var(--cream);
    font: inherit;
    transition: border-color 0.4s var(--ease-film);
  }

  select {
    appearance: none;
    background: linear-gradient(45deg, transparent 50%, var(--amber) 50%) right 6px center / 8px 8px no-repeat,
      transparent;
    cursor: pointer;
  }

  select option {
    background: var(--ink);
  }

  textarea {
    resize: vertical;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-bottom-color: var(--orange);
    box-shadow: 0 1px 0 var(--orange);
  }

  .btn {
    justify-self: start;
    margin-top: 0.5rem;
  }
</style>

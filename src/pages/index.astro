---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SiteTop from '../components/SiteTop.astro';
import paparazziPainting from '../assets/images/paparazzi-painting.png';
import paparazziDuotone from '../assets/images/paparazzi-duotone.png';
import pressCrowd from '../assets/images/press-crowd.png';
import colosseum from '../assets/images/colosseum.png';

const artwork = [
  { src: paparazziPainting, alt: 'Painted crowd of photographers aiming cameras, with the New Romans name across the middle' },
  { src: paparazziDuotone, alt: 'Red and purple duotone photo of photographers around a woman in sunglasses, with the New Romans name' },
  { src: pressCrowd, alt: 'Overhead photo of a press scrum with cameras and microphones, with the New Romans name' },
  { src: colosseum, alt: 'Painting of a Roman amphitheatre beneath an erupting volcano, with the New Romans name' },
];
---

<Base bare>
  <SiteTop />

  <section class="soon">
    <h1 class="visually-hidden">New Romans</h1>
    <div class="grid">
      {artwork.map(({ src, alt }, i) => (
        <div class="tile">
          <Image
            src={src}
            alt={alt}
            widths={[400, 700, 1000]}
            sizes="(max-width: 600px) 100vw, min(50vw, 55svh, 550px)"
            format="webp"
            quality={80}
            loading={i < 2 ? 'eager' : 'lazy'}
          />
        </div>
      ))}
    </div>
  </section>
</Base>

<script>
  // Tilt each sleeve toward the pointer, like turning a record in the light.
  // On touch screens the sleeves tilt with scroll position instead.
  const tiles = document.querySelectorAll<HTMLElement>('.tile');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const MAX_TILT = 14;

  function tilt(tile: HTMLElement, x: number, y: number) {
    // x and y run from -0.5 to 0.5 across the tile.
    tile.style.setProperty('--rx', `${(-y * MAX_TILT * 2).toFixed(2)}deg`);
    tile.style.setProperty('--ry', `${(x * MAX_TILT * 2).toFixed(2)}deg`);
    tile.style.setProperty('--gx', `${((x + 0.5) * 100).toFixed(1)}%`);
    tile.style.setProperty('--gy', `${((y + 0.5) * 100).toFixed(1)}%`);
  }

  if (!reduced && hover) {
    tiles.forEach((tile) => {
      tile.addEventListener('pointerenter', () => tile.classList.add('is-active'));
      tile.addEventListener('pointermove', (e) => {
        const r = tile.getBoundingClientRect();
        tilt(tile, (e.clientX - r.left) / r.width - 0.5, (e.clientY - r.top) / r.height - 0.5);
      });
      tile.addEventListener('pointerleave', () => {
        tile.classList.remove('is-active');
        tilt(tile, 0, 0);
      });
    });
  } else if (!reduced) {
    let queued = false;
    const update = () => {
      queued = false;
      tiles.forEach((tile, i) => {
        const r = tile.getBoundingClientRect();
        const y = Math.max(-0.5, Math.min(0.5, (r.top + r.height / 2 - innerHeight / 2) / innerHeight));
        tilt(tile, i % 2 ? -y * 0.4 : y * 0.4, y);
      });
    };
    addEventListener('scroll', () => {
      if (!queued) requestAnimationFrame(update);
      queued = true;
    }, { passive: true });
    update();
  }
</script>

<style>
  .soon {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    min-height: 100svh;
    padding: var(--header-space) var(--gutter) var(--gutter);
    background: #000;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(16px, 3vw, 40px);
    /* Two square tiles per row; the bottom row may run just past the fold on desktop. */
    width: min(100%, 110svh, 1100px);
  }

  .grid {
    perspective: 900px;
  }

  .tile {
    position: relative;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.6s var(--ease-film), box-shadow 0.6s var(--ease-film);
    will-change: transform;
  }

  .tile.is-active {
    z-index: 1;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) scale(1.04);
    transition-duration: 0.12s, 0.6s;
    box-shadow: 0 24px 50px -12px rgb(0 0 0 / 0.9);
  }

  /* A soft sheen that follows the pointer, like light catching a sleeve. */
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at var(--gx, 50%) var(--gy, 50%), rgb(255 244 220 / 0.28), transparent 55%);
    mix-blend-mode: soft-light;
    opacity: 0;
    transition: opacity 0.4s var(--ease-film);
  }

  .tile.is-active::after {
    opacity: 1;
  }

  .grid img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
      width: 100%;
    }
  }
</style>

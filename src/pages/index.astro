---
import Base from '../layouts/Base.astro';
import LightLeak from '../components/LightLeak.astro';
---

<Base>
  <section class="hero">
    <LightLeak />

    <div class="hero-inner wrap">
      <h1 class="display hero-title">
        <span class="line"><span>New</span></span>
        <span class="line"><span>Romans</span></span>
      </h1>

      <p class="hero-tag accent">Coming soon</p>

      <div class="hero-cta">
        <a class="btn" href="/contact/">Get in touch</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(ellipse at 80% 10%, #3a1d0c 0%, transparent 55%),
      radial-gradient(ellipse at 10% 90%, #2a1708 0%, transparent 50%),
      var(--black);
  }

  .hero-inner {
    position: relative;
    padding-bottom: clamp(5rem, 12vh, 9rem);
  }

  .hero-title {
    font-size: clamp(5rem, 1rem + 19vw, 18rem);
    line-height: 0.82;
    color: var(--cream);
  }

  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.02em;
  }

  .line > span {
    display: inline-block;
    animation: rise 1.8s var(--ease-film) both;
  }

  .line:nth-child(2) > span {
    animation-delay: 0.18s;
    color: var(--orange);
  }

  .hero-tag {
    margin: 1rem 0 2.25rem;
    font-size: clamp(1.6rem, 1rem + 2.6vw, 3.25rem);
    line-height: 1.1;
    animation: fade-up 1.8s var(--ease-film) 0.6s both;
  }

  .hero-cta {
    animation: fade-up 1.8s var(--ease-film) 0.85s both;
  }

  @keyframes rise {
    from { transform: translateY(105%); }
    to { transform: none; }
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: none; }
  }
</style>

---
import Base from '../layouts/Base.astro';
---

<Base bare>
  <section class="soon">
    <h1>Coming soon...</h1>
  </section>
</Base>

<style>
  .soon {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: var(--gutter);
    background: #000;
  }

  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2rem, 1.2rem + 3vw, 4rem);
    color: var(--cream);
  }
</style>

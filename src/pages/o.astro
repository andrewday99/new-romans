---
import Base from '../layouts/Base.astro';
---

<Base title="O" description="You found it." bare noindex>
  <section class="inside">
    <p class="kicker">We're so glad you made it...</p>
    <div class="player">
      <iframe
        style="border-radius: 24px"
        src="https://untitled.stream/embed/l2GEMvwbvust"
        title="Playlist"
        width="100%"
        height="344"
        allowfullscreen
        allow="picture-in-picture"
        frameborder="0"
        loading="eager"></iframe>
    </div>
    <a href="/" class="back">Back out</a>
  </section>
</Base>

<style>
  :global(body) {
    background: #000;
  }

  .inside {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    min-height: 100svh;
    padding: var(--gutter);
    background: #000;
    text-align: center;
    animation: arrive 1.4s var(--ease-film) both;
  }

  .kicker {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.6rem, 1.1rem + 2vw, 3rem);
    line-height: 1.1;
    color: #fef1c3;
  }

  .player {
    width: min(640px, calc(100vw - var(--gutter) * 2));
    animation: arrive 1.4s 0.35s var(--ease-film) both;
  }

  .player iframe {
    display: block;
  }

  .back {
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 0.7rem + 0.25vw, 0.9rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cream-dim);
    text-decoration: none;
    animation: arrive 1.4s 0.7s var(--ease-film) both;
  }

  .back:hover,
  .back:focus-visible {
    color: var(--cream);
  }

  @keyframes arrive {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .inside,
    .player,
    .back {
      animation: none;
    }
  }
</style>

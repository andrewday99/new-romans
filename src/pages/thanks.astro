---
import Base from '../layouts/Base.astro';
---

<Base title="Thanks" description="Thanks for getting in touch with New Romans.">
  <header class="page-head wrap thanks">
    <p class="label">Message received</p>
    <h1 class="display">
      Thank <span class="accent">you</span>
    </h1>
    <p class="lede">We'll get back to you soon.</p>
    <a class="btn btn--ghost" href="/">Back home</a>
  </header>
</Base>

<style>
  .thanks {
    padding-bottom: clamp(5rem, 12vw, 10rem);
  }
</style>

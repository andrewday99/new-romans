---
import Base from '../layouts/Base.astro';
import { bio, members } from '../config';
---

<Base title="About" description="About New Romans — who we are and what we sound like.">
  <header class="page-head wrap">
    <p class="label" data-reveal>Liner notes</p>
    <h1 class="display" data-reveal style="--reveal-delay: 0.1s">
      About <span class="accent">the band</span>
    </h1>
  </header>

  <section class="wrap about">
    <div class="bio">
      {
        bio.map((para, i) => (
          <p class={i === 0 ? 'lede' : ''} data-reveal style={`--reveal-delay: ${i * 0.1}s`}>
            {para}
          </p>
        ))
      }
    </div>

    <aside class="lineup" data-reveal style="--reveal-delay: 0.2s">
      <h2 class="label">Lineup</h2>
      <ul>
        {
          members.map((m) => (
            <li>
              <span class="display name">{m.name}</span>
              <span class="accent role">{m.role}</span>
            </li>
          ))
        }
      </ul>
    </aside>
  </section>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-bottom: clamp(4rem, 10vw, 8rem);
  }

  @media (max-width: 820px) {
    .about {
      grid-template-columns: 1fr;
    }
  }

  .bio p {
    max-width: 62ch;
    margin: 0 0 1.4em;
  }

  .bio .lede {
    margin-bottom: 1em;
  }

  .lineup h2 {
    margin: 0 0 1rem;
  }

  .lineup ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--umber);
  }

  .lineup li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--umber);
  }

  .name {
    font-size: 1.75rem;
  }

  .role {
    font-size: 1.2rem;
  }
</style>

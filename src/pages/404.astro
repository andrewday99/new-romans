---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <header class="page-head wrap lost">
    <p class="label">Frame 404</p>
    <h1 class="display">
      Lost <span class="accent">in the darkroom</span>
    </h1>
    <p class="lede">That page didn't develop.</p>
    <a class="btn" href="/">Back home</a>
  </header>
</Base>

<style>
  .lost {
    padding-bottom: clamp(5rem, 12vw, 10rem);
  }
</style>

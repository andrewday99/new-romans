---
import { Image } from 'astro:assets';
import SocialIcons from './SocialIcons.astro';
import logo from '../assets/images/logo.png';

const path = Astro.url.pathname.replace(/\/?$/, '/');
---

<header class="top">
  <a href="/" class="brand">
    <Image src={logo} alt="New Romans" draggable="false" width={340} densities={[1, 2]} loading="eager" />
    <span class="o-hole" data-o-hole aria-hidden="true"></span>
  </a>
  <nav class="links" aria-label="Main">
    <a href="/contact/" class="tab" aria-current={path === '/contact/' ? 'page' : undefined}>Contact</a>
    <SocialIcons />
  </nav>
</header>

<p class="note" role="status" aria-live="polite" data-note></p>

<script>
  // Secret: hold the cursor inside the O of "NEW ROMANS" for 3 seconds and the
  // O opens up into /o/. Geometry below is in logo.png pixels (1320 × 200).
  const HOLD_MS = 3000;
  const LOGO = { w: 1320, h: 200 };
  const O_OUTER = { x: 609, y: 21, w: 145, h: 144, stroke: 30 };

  const hole = document.querySelector<HTMLElement>('[data-o-hole]');
  const brand = hole?.closest<HTMLAnchorElement>('.brand');
  const logoImg = brand?.querySelector('img');
  let holdTimer: number | undefined;
  let opened = false;

  const prefetch = () => {
    if (document.querySelector('link[data-o-prefetch]')) return;
    const link = Object.assign(document.createElement('link'), { rel: 'prefetch', href: '/o/' });
    link.dataset.oPrefetch = '';
    document.head.append(link);
  };

  const startHold = () => {
    if (opened || !hole) return;
    prefetch();
    hole.classList.add('is-holding');
    clearTimeout(holdTimer);
    holdTimer = window.setTimeout(openO, HOLD_MS);
  };

  const cancelHold = () => {
    if (opened) return;
    clearTimeout(holdTimer);
    hole?.classList.remove('is-holding');
  };

  function openO() {
    if (!logoImg) return;
    opened = true;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      window.location.href = '/o/';
      return;
    }

    const r = logoImg.getBoundingClientRect();
    const sx = r.width / LOGO.w;
    const sy = r.height / LOGO.h;
    const left = r.left + O_OUTER.x * sx;
    const top = r.top + O_OUTER.y * sy;
    const width = O_OUTER.w * sx;
    const height = O_OUTER.h * sy;
    const stroke = O_OUTER.stroke * sx;

    // Scale until the inside of the O covers the farthest corner of the screen.
    const cx = left + width / 2;
    const cy = top + height / 2;
    const reach = Math.max(
      Math.hypot(cx, cy),
      Math.hypot(window.innerWidth - cx, cy),
      Math.hypot(cx, window.innerHeight - cy),
      Math.hypot(window.innerWidth - cx, window.innerHeight - cy),
    );
    const scale = (reach / (Math.min(width, height) / 2 - stroke)) * 1.15;

    const portal = document.createElement('div');
    portal.className = 'o-portal';
    Object.assign(portal.style, {
      left: `${left}px`,
      top: `${top}px`,
      width: `${width}px`,
      height: `${height}px`,
      borderWidth: `${stroke}px`,
    });
    document.body.append(portal);

    const zoom = portal.animate(
      [
        // A small inhale, then the O rushes out past the edges of the screen.
        { transform: 'scale(1)', easing: 'cubic-bezier(0.3, 0, 0.4, 1)' },
        { transform: 'scale(0.86)', offset: 0.2, easing: 'cubic-bezier(0.55, 0, 0.9, 0.45)' },
        { transform: `scale(${scale})` },
      ],
      { duration: 1800, fill: 'forwards' },
    );
    zoom.finished.then(() => {
      window.location.href = '/o/';
    });
  }

  if (hole && brand) {
    // Mouse: rest the cursor inside the O.
    hole.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') startHold();
    });
    hole.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse') cancelHold();
    });

    // Touch: the O is too small to hit reliably with a finger, so pressing and
    // holding anywhere on the logo counts. A little finger drift is allowed.
    const DRIFT_PX = 30;
    let touchId: number | null = null;
    let startX = 0;
    let startY = 0;

    const endTouch = (e: PointerEvent) => {
      if (e.pointerId !== touchId) return;
      touchId = null;
      cancelHold();
    };

    brand.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' || touchId !== null) return;
      touchId = e.pointerId;
      startX = e.clientX;
      startY = e.clientY;
      startHold();
    });
    brand.addEventListener('pointermove', (e) => {
      if (e.pointerId !== touchId) return;
      if (Math.hypot(e.clientX - startX, e.clientY - startY) > DRIFT_PX) endTouch(e);
    });
    brand.addEventListener('pointerup', endTouch);
    brand.addEventListener('pointercancel', endTouch);

    // No long-press menu or link preview on the logo, and once the O has
    // opened, the finger lifting must not count as a tap on the home link.
    brand.addEventListener('contextmenu', (e) => e.preventDefault());
    brand.addEventListener('dragstart', (e) => e.preventDefault());
    brand.addEventListener('click', (e) => {
      if (opened) e.preventDefault();
    });
  }

  const note = document.querySelector<HTMLElement>('[data-note]');
  let timer: number | undefined;

  document.querySelectorAll('[data-not-ready]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!note) return;
      note.textContent = "Be patient! We're not quite ready yet.";
      note.classList.add('is-visible');
      clearTimeout(timer);
      timer = window.setTimeout(() => note.classList.remove('is-visible'), 2800);
    });
  });
</script>

<style>
  .top {
    position: absolute;
    top: var(--gutter);
    left: var(--gutter);
    right: var(--gutter);
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
  }

  .brand {
    position: relative;
    display: block;
    /* The logo doubles as the touch target for the secret hold: no scrolling,
       callout menu, image drag or text selection starting from it. */
    touch-action: none;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .brand img {
    -webkit-user-drag: none;
  }

  .brand img {
    display: block;
    width: clamp(170px, 26vw, 340px);
    height: auto;
  }

  /* Sits exactly over the counter (the hole) of the O in logo.png. */
  .o-hole {
    position: absolute;
    left: calc(640 / 1320 * 100%);
    top: calc(49 / 200 * 100%);
    width: calc(83 / 1320 * 100%);
    height: calc(87 / 200 * 100%);
    border-radius: 50%;
  }

  .o-hole::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(closest-side, rgb(254 241 195 / 0.55), rgb(254 241 195 / 0) 100%);
    opacity: 0;
    transform: scale(0.4);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  /* A slow warm glow builds inside the O while the cursor holds there. */
  .o-hole.is-holding::before {
    opacity: 1;
    transform: scale(1);
    transition:
      opacity 3s linear,
      transform 3s cubic-bezier(0.5, 0, 0.75, 0);
  }

  :global(.o-portal) {
    position: fixed;
    z-index: 1000;
    border: 0 solid #fef1c3;
    border-radius: 50%;
    background: #000;
    pointer-events: none;
    will-change: transform;
  }

  .links {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.75rem);
  }

  /* Phones: icons and Contact drop to their own row under the logo. */
  @media (max-width: 600px) {
    .top {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .tab {
    position: relative;
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 0.7rem + 0.3vw, 0.95rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cream);
    text-decoration: none;
  }

  .tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.16em;
    bottom: -6px;
    height: 2px;
    background: var(--cream);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-film);
  }

  .tab:hover::after,
  .tab:focus-visible::after,
  .tab[aria-current='page']::after {
    transform: scaleX(1);
  }

  .note {
    position: fixed;
    top: calc(var(--gutter) + clamp(56px, 6vw, 72px));
    right: var(--gutter);
    z-index: 20;
    margin: 0;
    padding: 0.85rem 1.25rem;
    border: 1px solid rgb(239 227 204 / 0.35);
    background: #0b0b0b;
    color: var(--cream);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.3rem);
    pointer-events: none;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.35s var(--ease-film), transform 0.35s var(--ease-film);
  }

  .note.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 600px) {
    .note {
      top: auto;
      bottom: var(--gutter);
      left: var(--gutter);
      text-align: center;
    }
  }
</style>

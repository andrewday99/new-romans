---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  /** Only show the first N photos (e.g. a teaser strip on the home page). */
  limit?: number;
  /** Open full-size photos in a lightbox. */
  lightbox?: boolean;
}

const { limit, lightbox = true } = Astro.props;

// Drop .jpg/.png/.webp/.avif files into src/assets/photos — they are picked up automatically,
// sorted by filename (prefix with 01-, 02-… to control order). The filename becomes the alt
// text, so name them descriptively, e.g. "03-live-at-the-roxy.jpg".
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG}',
  { eager: true },
);

const toAlt = (path: string) =>
  path
    .split('/')
    .pop()!
    .replace(/\.[^.]+$/, '')
    .replace(/^\d+[-_ ]*/, '')
    .replace(/[-_]+/g, ' ')
    .trim() || 'New Romans';

const all = await Promise.all(
  Object.entries(files)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([path, mod]) => ({
      src: mod.default,
      alt: toAlt(path),
      full: lightbox ? (await getImage({ src: mod.default, width: 2000 })).src : null,
    })),
);

const photos = limit ? all.slice(0, limit) : all;
const placeholders = Array.from({ length: limit ?? 6 }, (_, i) => i);
const frameNo = (i: number) => `${String(i + 1).padStart(2, '0')}A`;
---

<div class="grid" data-lightbox-root={lightbox ? '' : undefined}>
  {
    photos.length > 0
      ? photos.map((p, i) => (
          <figure class="frame" data-reveal style={`--reveal-delay: ${(i % 3) * 0.15}s`}>
            {p.full ? (
              <a href={p.full} class="shot" data-lightbox>
                <Image src={p.src} alt={p.alt} widths={[480, 800, 1200]} sizes="(max-width: 700px) 100vw, 33vw" />
              </a>
            ) : (
              <div class="shot">
                <Image src={p.src} alt={p.alt} widths={[480, 800, 1200]} sizes="(max-width: 700px) 100vw, 33vw" />
              </div>
            )}
            <figcaption class="edge">
              <span>KODAK 400</span>
              <span>▸ {frameNo(i)}</span>
            </figcaption>
          </figure>
        ))
      : placeholders.map((i) => (
          <figure class="frame" data-reveal style={`--reveal-delay: ${(i % 3) * 0.15}s`}>
            <div class={`shot placeholder placeholder--${i % 4}`}>
              <span class="label">Photo {frameNo(i)} — add to src/assets/photos</span>
            </div>
            <figcaption class="edge">
              <span>KODAK 400</span>
              <span>▸ {frameNo(i)}</span>
            </figcaption>
          </figure>
        ))
  }
</div>

{
  lightbox && photos.length > 0 && (
    <dialog class="lightbox" data-lightbox-dialog aria-label="Photo viewer">
      <form method="dialog">
        <button class="close" aria-label="Close">×</button>
      </form>
      <img alt="" data-lightbox-img />
    </dialog>
  )
}

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
  const img = dialog?.querySelector<HTMLImageElement>('[data-lightbox-img]');

  if (dialog && img) {
    document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const thumb = link.querySelector('img');
        img.src = link.href;
        img.alt = thumb?.alt ?? '';
        dialog.showModal();
      });
    });

    // Clicking the backdrop (the dialog itself, outside the image) closes it.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .frame {
    margin: 0;
    padding: 18px 12px 10px;
    background:
      /* sprocket holes along the top edge */
      radial-gradient(circle at 50% 50%, var(--black) 0 3px, transparent 3.5px) 0 4px / 18px 10px repeat-x,
      #1d140d;
  }

  .shot {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--umber);
  }

  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.28) saturate(1.15) contrast(1.06) brightness(0.95);
    transform: scale(1.02);
    transition:
      filter 1.2s var(--ease-film),
      transform 1.6s var(--ease-film);
  }

  a.shot:hover :global(img) {
    filter: sepia(0.05) saturate(1.05) contrast(1.02);
    transform: scale(1.06);
  }

  .edge {
    display: flex;
    justify-content: space-between;
    padding-top: 8px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    color: var(--orange);
  }

  .placeholder {
    display: grid;
    place-items: end start;
    padding: 1rem;
  }

  .placeholder--0 { background: radial-gradient(circle at 70% 30%, #e8a33d, #c4501b 45%, #2a1c12 85%); }
  .placeholder--1 { background: linear-gradient(160deg, #3b2414, #c4501b 60%, #f0b25a); }
  .placeholder--2 { background: radial-gradient(ellipse at 30% 80%, #f2c27a, #8a3a14 50%, #120c08 90%); }
  .placeholder--3 { background: linear-gradient(20deg, #120c08 10%, #6b2c10 50%, #e8a33d 95%); }

  .placeholder .label {
    color: var(--cream);
    mix-blend-mode: overlay;
    font-size: 0.65rem;
  }

  .lightbox {
    max-width: min(92vw, 1400px);
    max-height: 92vh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgba(8, 5, 2, 0.92);
  }

  .lightbox img {
    max-width: 100%;
    max-height: 92vh;
    object-fit: contain;
  }

  .close {
    position: absolute;
    top: -3rem;
    right: 0;
    width: 44px;
    height: 44px;
    border: 0;
    background: none;
    color: var(--cream);
    font-size: 2.25rem;
    line-height: 1;
    cursor: pointer;
  }
</style>

---
// Drifting warm blooms that mimic light bleeding onto the edge of a film frame.
---

<div class="leak" aria-hidden="true">
  <span class="blob blob--a"></span>
  <span class="blob blob--b"></span>
  <span class="blob blob--c"></span>
  <span class="flare"></span>
</div>

<style>
  .leak {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0;
    will-change: transform, opacity;
  }

  .blob--a {
    width: 70vmax;
    height: 55vmax;
    top: -25vmax;
    right: -25vmax;
    background: radial-gradient(circle, #ff7a2a 0%, #c4501b 40%, transparent 70%);
    animation:
      drift-a 22s ease-in-out infinite alternate,
      breathe 9s ease-in-out infinite;
  }

  .blob--b {
    width: 45vmax;
    height: 60vmax;
    bottom: -30vmax;
    left: -18vmax;
    background: radial-gradient(circle, #ffc35c 0%, #e8a33d 35%, transparent 70%);
    animation:
      drift-b 28s ease-in-out infinite alternate,
      breathe 12s ease-in-out -4s infinite;
  }

  .blob--c {
    width: 30vmax;
    height: 80vmax;
    top: -20vmax;
    left: 38%;
    background: radial-gradient(ellipse, rgba(255, 90, 40, 0.9) 0%, transparent 65%);
    animation:
      drift-c 34s ease-in-out infinite alternate,
      breathe 15s ease-in-out -7s infinite;
  }

  /* A soft vertical streak, like a leak along the film's edge. */
  .flare {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 6%;
    width: 18vw;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 150, 60, 0.35) 45%,
      rgba(255, 220, 160, 0.5) 50%,
      rgba(255, 150, 60, 0.35) 55%,
      transparent
    );
    filter: blur(24px);
    opacity: 0;
    animation: flicker 11s ease-in-out 2s infinite;
  }

  @keyframes breathe {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 0.8; }
  }

  @keyframes drift-a {
    to { transform: translate(-12vw, 10vh) scale(1.15); }
  }

  @keyframes drift-b {
    to { transform: translate(14vw, -8vh) scale(1.2); }
  }

  @keyframes drift-c {
    to { transform: translate(-20vw, 6vh) rotate(18deg); }
  }

  @keyframes flicker {
    0%, 100% { opacity: 0; transform: translateX(0); }
    8% { opacity: 0.7; }
    12% { opacity: 0.25; }
    18% { opacity: 0.9; }
    40% { opacity: 0.15; transform: translateX(-8vw); }
    55% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob { opacity: 0.55; animation: none; }
    .flare { animation: none; }
  }
</style>
